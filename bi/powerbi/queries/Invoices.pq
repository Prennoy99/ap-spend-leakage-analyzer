// Invoices: bi/data/invoices.csv
// Generated by scripts/export_bi_data.py; don't edit by hand.
// Power BI: Transform data > New Source > Blank Query > Advanced Editor, paste, rename the query.
let
    Source = Csv.Document(
        File.Contents(DataFolder & "invoices.csv"),
        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
    ),
    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
    // An empty field is a missing value, not empty text
    Blanks = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
    // "en-US": the files use "." for decimals and ISO dates, whatever the PC's locale
    Typed = Table.TransformColumnTypes(Blanks, {
        {"invoice_id", type text},
        {"vendor_id", type text},
        {"vendor_name", type text},
        {"department", type text},
        {"category", type text},
        {"po_number", type text},
        {"has_po", type logical},
        {"invoice_date", type date},
        {"submitted_date", type date},
        {"approved_date", type date},
        {"paid_date", type date},
        {"due_date", type date},
        {"discount_date", type date},
        {"amount", type number},
        {"status", type text},
        {"payment_terms", type text},
        {"processing_days", type number},
        {"invoice_month", type text},
        {"paid_month", type text},
        {"is_paid", type logical},
        {"paid_on_time", type logical},
        {"discount_taken", type logical},
        {"path_type", type text},
        {"rework_loops", Int64.Type}
    }, "en-US")
in
    Typed

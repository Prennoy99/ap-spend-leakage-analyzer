<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_ToBe"
                  targetNamespace="http://example.com/rheinwerk/ap-spend-leakage">

  <!-- To-be invoice-to-pay at Rheinwerk HQ (fictional client), Improve task 5.3.
       Generated by scripts/build_to_be_bpmn.py. Lanes are roles or the ERP, never people.
       Text annotations mark each change against the as-is model with its fix number,
       € figure and issue-tree hypothesis. -->

  <bpmn:collaboration id="Collaboration_ToBe">
    <bpmn:participant id="Participant_Supplier" name="Supplier" />
    <bpmn:participant id="Participant_HQ" name="Rheinwerk HQ: invoice-to-pay (to-be)" processRef="Process_ToBe" />
    <bpmn:messageFlow id="Msg_Invoice" name="Invoice (e-invoice or PDF)" sourceRef="Participant_Supplier" targetRef="Start_InvoiceReceived" />
    <bpmn:messageFlow id="Msg_DuplicateNotice" name="Duplicate notice" sourceRef="Task_ReviewDuplicate" targetRef="Participant_Supplier" />
    <bpmn:messageFlow id="Msg_Payment" name="Payment" sourceRef="Task_Transfer" targetRef="Participant_Supplier" />
  </bpmn:collaboration>

  <bpmn:process id="Process_ToBe" name="Invoice-to-pay (to-be)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ToBe">
      <bpmn:lane id="Lane_ERP" name="ERP (automated)">
        <bpmn:flowNodeRef>Start_InvoiceReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Capture</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_EntryOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DuplicateCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Duplicate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_POInvoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ThreeWayMatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Match</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AutoApprove</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Schedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_DailyRun</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Proposal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Paid</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_APClerk" name="AP clerk">
        <bpmn:flowNodeRef>Task_Clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewDuplicate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_DuplicateStopped</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Correct</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BudgetOwner" name="Budget owner">
        <bpmn:flowNodeRef>Task_Approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_ApprovalDeadline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Approved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_APManager" name="AP Manager">
        <bpmn:flowNodeRef>Task_Escalate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Chased</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Release</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Treasury" name="Treasury">
        <bpmn:flowNodeRef>Task_Transfer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Controlling" name="Controlling">
        <bpmn:flowNodeRef>Start_Weekly</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BudgetReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_BudgetActed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_InvoiceReceived" name="Invoice received">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Start_InvoiceReceived" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Capture" name="Capture invoice data (e-invoice import; RPA bot reads PDFs)">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Validate" name="Validate at entry: supplier, cost centre, PO or exception reason">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_EntryOK" name="Entry data complete?">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Clarify" name="Complete data with requester or supplier">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_DuplicateCheck" name="Duplicate check: PO already invoiced, or same supplier and amount within 5 days">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Duplicate" name="Suspected duplicate?">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ReviewDuplicate" name="Review the flag: reject the copy, tell the supplier">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_DuplicateStopped" name="Duplicate stopped before payment">
      <bpmn:incoming>Flow_09</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_POInvoice" name="PO invoice?">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ThreeWayMatch" name="Three-way match: PO, goods receipt, invoice">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Match" name="Within tolerance?">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_AutoApprove" name="Approve automatically (approved when the PO was released)">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_Approve" name="Review and approve, remaining budget shown">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Timer_ApprovalDeadline" name="2 days before the discount date" attachedToRef="Task_Approve" cancelActivity="false">
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_Timer_ApprovalDeadline" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Task_Escalate" name="Chase the overdue approval">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Chased" name="Approval chased">
      <bpmn:incoming>Flow_22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_Approved" name="Approved?">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Correct" name="Correct invoice or query supplier">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_MergeApproved">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Schedule" name="Schedule payment: discount date if offered, else due date">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Timer_DailyRun" name="Daily payment run">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_Timer_DailyRun" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_Proposal" name="Create payment proposal: due today and approved only">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_Release" name="Release payment proposal">
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Task_Transfer" name="Execute bank transfer">
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="Task_Post" name="Post payment and clear invoice">
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Paid" name="Invoice paid on terms">
      <bpmn:incoming>Flow_29</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Start_Weekly" name="Every Monday">
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_Start_Weekly" />
    </bpmn:startEvent>
    <bpmn:userTask id="Task_BudgetReview" name="Review budget vs actual (live view)">
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_BudgetActed" name="Overruns handled before month-end">
      <bpmn:incoming>Flow_31</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_InvoiceReceived" targetRef="Task_Capture" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_Capture" targetRef="Task_Validate" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_Validate" targetRef="Gateway_EntryOK" />
    <bpmn:sequenceFlow id="Flow_04" name="Yes" sourceRef="Gateway_EntryOK" targetRef="Task_DuplicateCheck" />
    <bpmn:sequenceFlow id="Flow_05" name="No" sourceRef="Gateway_EntryOK" targetRef="Task_Clarify" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_Clarify" targetRef="Task_Validate" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_DuplicateCheck" targetRef="Gateway_Duplicate" />
    <bpmn:sequenceFlow id="Flow_08" name="Yes" sourceRef="Gateway_Duplicate" targetRef="Task_ReviewDuplicate" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_ReviewDuplicate" targetRef="End_DuplicateStopped" />
    <bpmn:sequenceFlow id="Flow_10" name="No" sourceRef="Gateway_Duplicate" targetRef="Gateway_POInvoice" />
    <bpmn:sequenceFlow id="Flow_11" name="Yes" sourceRef="Gateway_POInvoice" targetRef="Task_ThreeWayMatch" />
    <bpmn:sequenceFlow id="Flow_12" name="No: exception" sourceRef="Gateway_POInvoice" targetRef="Task_Approve" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_ThreeWayMatch" targetRef="Gateway_Match" />
    <bpmn:sequenceFlow id="Flow_14" name="Yes" sourceRef="Gateway_Match" targetRef="Task_AutoApprove" />
    <bpmn:sequenceFlow id="Flow_15" name="No" sourceRef="Gateway_Match" targetRef="Task_Approve" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_AutoApprove" targetRef="Gateway_MergeApproved" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_Approve" targetRef="Gateway_Approved" />
    <bpmn:sequenceFlow id="Flow_18" name="Yes" sourceRef="Gateway_Approved" targetRef="Gateway_MergeApproved" />
    <bpmn:sequenceFlow id="Flow_19" name="No" sourceRef="Gateway_Approved" targetRef="Task_Correct" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_Correct" targetRef="Task_Approve" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Timer_ApprovalDeadline" targetRef="Task_Escalate" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_Escalate" targetRef="End_Chased" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Gateway_MergeApproved" targetRef="Task_Schedule" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_Schedule" targetRef="Timer_DailyRun" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Timer_DailyRun" targetRef="Task_Proposal" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_Proposal" targetRef="Task_Release" />
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_Release" targetRef="Task_Transfer" />
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Task_Transfer" targetRef="Task_Post" />
    <bpmn:sequenceFlow id="Flow_29" sourceRef="Task_Post" targetRef="End_Paid" />
    <bpmn:sequenceFlow id="Flow_30" sourceRef="Start_Weekly" targetRef="Task_BudgetReview" />
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Task_BudgetReview" targetRef="End_BudgetActed" />
    <bpmn:textAnnotation id="Note_Capture">
      <bpmn:text>NEW · RPA bot (e.g. UiPath) reads PDF invoices; e-invoices (XRechnung, ZUGFeRD) are imported. Designed and costed, not built</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Note_Capture" sourceRef="Task_Capture" targetRef="Note_Capture" />
    <bpmn:textAnnotation id="Note_Validate">
      <bpmn:text>FIX 4 · Stops wrong cost centres and missing POs: 55% of today's rejections (D1)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Note_Validate" sourceRef="Task_Validate" targetRef="Note_Validate" />
    <bpmn:textAnnotation id="Note_Duplicate">
      <bpmn:text>FIX 1 · Would have stopped 46 of 50 duplicates, €57.7k a year, before payment (A1)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Note_Duplicate" sourceRef="Task_DuplicateCheck" targetRef="Note_Duplicate" />
    <bpmn:textAnnotation id="Note_ThreeWay">
      <bpmn:text>NEW · PO, goods receipt and invoice must agree. Covers A2 once PO prices are in the ERP</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Note_ThreeWay" sourceRef="Task_ThreeWayMatch" targetRef="Note_ThreeWay" />
    <bpmn:textAnnotation id="Note_AutoApprove">
      <bpmn:text>NEW · No second approval for matched PO invoices: the budget owner approved the PO</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Note_AutoApprove" sourceRef="Task_AutoApprove" targetRef="Note_AutoApprove" />
    <bpmn:textAnnotation id="Note_Approve">
      <bpmn:text>FIX 3 · Deadline 2 days before the discount date; remaining budget shown (B1, B2, C1)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Note_Approve" sourceRef="Task_Approve" targetRef="Note_Approve" />
    <bpmn:textAnnotation id="Note_Schedule">
      <bpmn:text>FIX 2 · Pay to terms (B3): discounts on the last discount day, the rest on the due date</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Note_Schedule" sourceRef="Task_Schedule" targetRef="Note_Schedule" />
    <bpmn:textAnnotation id="Note_Proposal">
      <bpmn:text>NEW · Payment block: no payment without a recorded approval (13 breaches today)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Note_Proposal" sourceRef="Task_Proposal" targetRef="Note_Proposal" />
    <bpmn:textAnnotation id="Note_Budget">
      <bpmn:text>NEW · Weekly live view: overruns approved or stopped before month-end, not found after it (C1)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Note_Budget" sourceRef="End_BudgetActed" targetRef="Note_Budget" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_ToBe">
    <bpmndi:BPMNPlane id="Plane_ToBe" bpmnElement="Collaboration_ToBe">
      <bpmndi:BPMNShape id="Participant_Supplier_di" bpmnElement="Participant_Supplier" isHorizontal="true">
        <dc:Bounds x="160" y="0" width="3310" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_HQ_di" bpmnElement="Participant_HQ" isHorizontal="true">
        <dc:Bounds x="160" y="230" width="3310" height="920" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_ERP_di" bpmnElement="Lane_ERP" isHorizontal="true">
        <dc:Bounds x="190" y="230" width="3280" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_APClerk_di" bpmnElement="Lane_APClerk" isHorizontal="true">
        <dc:Bounds x="190" y="420" width="3280" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_BudgetOwner_di" bpmnElement="Lane_BudgetOwner" isHorizontal="true">
        <dc:Bounds x="190" y="570" width="3280" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_APManager_di" bpmnElement="Lane_APManager" isHorizontal="true">
        <dc:Bounds x="190" y="740" width="3280" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Treasury_di" bpmnElement="Lane_Treasury" isHorizontal="true">
        <dc:Bounds x="190" y="890" width="3280" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Controlling_di" bpmnElement="Lane_Controlling" isHorizontal="true">
        <dc:Bounds x="190" y="1020" width="3280" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_InvoiceReceived_di" bpmnElement="Start_InvoiceReceived">
        <dc:Bounds x="297" y="307" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Capture_di" bpmnElement="Task_Capture">
        <dc:Bounds x="410" y="280" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Validate_di" bpmnElement="Task_Validate">
        <dc:Bounds x="570" y="280" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_EntryOK_di" bpmnElement="Gateway_EntryOK" isMarkerVisible="true">
        <dc:Bounds x="770" y="300" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="745" y="268" width="100" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Clarify_di" bpmnElement="Task_Clarify">
        <dc:Bounds x="730" y="450" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DuplicateCheck_di" bpmnElement="Task_DuplicateCheck">
        <dc:Bounds x="890" y="280" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Duplicate_di" bpmnElement="Gateway_Duplicate" isMarkerVisible="true">
        <dc:Bounds x="1090" y="300" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1065" y="268" width="100" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReviewDuplicate_di" bpmnElement="Task_ReviewDuplicate">
        <dc:Bounds x="1050" y="450" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_DuplicateStopped_di" bpmnElement="End_DuplicateStopped">
        <dc:Bounds x="1257" y="477" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_POInvoice_di" bpmnElement="Gateway_POInvoice" isMarkerVisible="true">
        <dc:Bounds x="1410" y="300" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1385" y="268" width="100" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ThreeWayMatch_di" bpmnElement="Task_ThreeWayMatch">
        <dc:Bounds x="1530" y="280" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Match_di" bpmnElement="Gateway_Match" isMarkerVisible="true">
        <dc:Bounds x="1730" y="300" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1705" y="268" width="100" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AutoApprove_di" bpmnElement="Task_AutoApprove">
        <dc:Bounds x="1850" y="280" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Approve_di" bpmnElement="Task_Approve">
        <dc:Bounds x="1850" y="610" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Escalate_di" bpmnElement="Task_Escalate">
        <dc:Bounds x="1850" y="770" width="130" height="90" />
      </bpmndi:BPMNShape>
